# Spring Boot 3.2 loads EnvironmentPostProcessors exclusively from
# META-INF/spring.factories (EnvironmentPostProcessorsFactory.fromSpringFactories).
# Without these entries, ${env} placeholders and the app identity from
# META-INF/app.config would not resolve. When upgrading to Spring Boot 4, migrate
# this registration to META-INF/spring/org.springframework.boot.env.EnvironmentPostProcessor.
org.springframework.boot.env.EnvironmentPostProcessor=com.armeria.grpc.common.env.OpsEnvironmentPostProcessor,com.armeria.grpc.common.env.AppIdEnvironmentPostProcessor
